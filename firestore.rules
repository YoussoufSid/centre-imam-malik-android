rules_version = '2';
// ⚠️ لا تنشر هذه القواعد قبل أن يظهر في «إعدادات المركز» (الهاتف أو الحاسوب) السطر: «🔒 حساب الإدارة مؤمَّن».
// صلاحية الإدارة صارت محفوظة في وثيقة حساب المدير (role = admin) بدل بريد مكتوب في الملف.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // The administration = role "admin" in the user's own document. Only an admin can change that document's role
    // (see /users below), so nobody can promote themselves.
    function isAdmin() { return hasProfile() && me().role == 'admin'; }
    function isStaff() { return hasProfile() && (me().role == 'admin' || me().role == 'teacher'); }
    // Parents and students may only read the student files linked to their account by the admin.
    function linkedTo(studentId) {
      return hasProfile() && studentId in me().get('studentIds', []);
    }
    // Size limits: a field is either absent or a string of at most n characters (blocks huge / malformed records).
    function okStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function validStudent() {
      let d = request.resource.data;
      return okStr(d, 'name', 120) && okStr(d, 'nameFr', 120) && okStr(d, 'photo', 60000) && okStr(d, 'phone', 40) && okStr(d, 'address', 200);
    }
    function validLog() {
      let d = request.resource.data;
      return okStr(d, 'surah', 60) && okStr(d, 'grade', 30) && okStr(d, 'notes', 500) && okStr(d, 'type', 30);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Self-registration always creates a plain account; the admin promotes it later.
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'student'
                    && !('studentIds' in request.resource.data);
      // Users may only change their own name/phone; role and links are set by the admin.
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']));
      allow delete: if isAdmin();
    }
    match /students/{studentId} {
      allow read: if isStaff() || linkedTo(studentId);
      allow create, update: if isStaff() && validStudent();
      allow delete: if isAdmin();
    }
    match /attendance/{recordId} {
      allow read: if isStaff() || linkedTo(resource.data.studentId);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /grades/{gradeId} {
      allow read: if isStaff() || linkedTo(resource.data.studentId);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /payments/{paymentId} {
      allow read: if isAdmin() || linkedTo(resource.data.studentId);
      allow write: if isAdmin();
    }
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }
    match /halaqat/{halaqaId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /payroll/{entryId} {
      allow read, write: if isAdmin();
    }
    match /cashAdvances/{advanceId} {
      allow read, write: if isAdmin();
    }
    match /teachers/{teacherId} {
      allow read, write: if isAdmin();
    }
    match /teacherAttendance/{recordId} {
      allow read, write: if isAdmin();
    }
    // Append-only audit trail: staff can add entries, only the admin can read them, nobody can change them.
    match /auditLog/{entryId} {
      allow create: if isStaff();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /quranLogs/{recordId} {
      allow read: if isStaff() || linkedTo(resource.data.studentId);
      allow create, update: if isStaff() && validLog();
      allow delete: if isAdmin();
    }
  }
}
